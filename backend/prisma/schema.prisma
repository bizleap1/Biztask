generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     Int                @id @default(autoincrement())
  name                   String
  email                  String             @unique
  password               String
  role                   String             @default("Employee") // SuperAdmin, Manager, TeamLead, Employee, ClientUser (legacy: DevEmployee, MediaEmployee, Viewer)
  designation            String?
  phone                  String?
  whatsappNumber         String?
  avatarUrl              String?
  googleId               String?            @unique
  tokenVersion           Int                @default(0)
  isActive               Boolean            @default(true)
  mustChangePassword     Boolean            @default(true)
  resetPasswordRequested Boolean            @default(false)
  canResetPassword       Boolean            @default(false)
  resetTokenHash         String?
  resetTokenExpiresAt    DateTime?
  departmentId           Int?
  department             Department?        @relation(fields: [departmentId], references: [id])
  assignedTasks          Task[]             @relation("AssignedTo")
  createdTasks           Task[]             @relation("AssignedBy")
  submissions            TaskSubmission[]   @relation("UserSubmissions")
  reviewedSubmissions    TaskSubmission[]   @relation("ReviewedBy")
  dailyReports           DailyReport[]      @relation("ReportOwner")
  reviewedDailyReports   DailyReport[]      @relation("ReportReviewedBy")
  activityLogs           ActivityLog[]
  comments               Comment[]
  notifications          Notification[]
  ledTeams               Team[]             @relation("TeamLead")
  teamMemberships        TeamMembership[]
  managedClients         Client[]           @relation("AccountManager")
  clientMemberships      ClientMembership[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([role])
  @@index([departmentId])
}

model Department {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  users        User[]
  teams        Team[]
  tasks        Task[]
  dailyReports DailyReport[]
  createdAt    DateTime      @default(now())
}

model Team {
  id           Int              @id @default(autoincrement())
  name         String
  departmentId Int?
  department   Department?      @relation(fields: [departmentId], references: [id])
  leadId       Int?
  lead         User?            @relation("TeamLead", fields: [leadId], references: [id])
  members      TeamMembership[]
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([name])
  @@index([departmentId])
  @@index([leadId])
}

model TeamMembership {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("Member") // Lead, Member
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Client {
  id               Int                @id @default(autoincrement())
  name             String
  companyName      String?
  email            String?
  phone            String?
  industry         String?
  status           String             @default("Active") // Active, At-Risk, Paused, Churned
  accountManagerId Int?
  accountManager   User?              @relation("AccountManager", fields: [accountManagerId], references: [id])
  memberships      ClientMembership[]
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([accountManagerId])
  @@index([status])
}

model ClientMembership {
  id        Int       @id @default(autoincrement())
  clientId  Int
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String    @default("Member") // Owner, Member
  isRevoked Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([clientId, userId])
  @@index([userId])
  @@index([isRevoked])
}

model Task {
  id             Int              @id @default(autoincrement())
  title          String
  description    String
  category       String
  priority       String           @default("Medium") // Low, Medium, High, Urgent
  status         String           @default("Pending") // Pending, In Progress, Submitted, Approved, Rejected, Overdue
  deadline       DateTime
  proofRequired  Boolean          @default(true)
  proofType      String?          // Image, PDF, Video, Link, Screenshot, GitHub PR, Website URL, Social Media Link
  clientName     String?          // General Project Field
  clientDetails  String?          // General Project Field
  driveLink      String?          // General Project Field
  socialMediaPlatform String?     // Media Dept Field
  postType       String?          // Media Dept Field
  githubRepo     String?          // Dev Dept Field
  environment    String?          // Dev Dept Field
  departmentId   Int
  department     Department       @relation(fields: [departmentId], references: [id])
  assignedToId   Int?
  assignedTo     User?            @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById   Int
  assignedBy     User             @relation("AssignedBy", fields: [assignedById], references: [id])
  submissions    TaskSubmission[]
  comments       Comment[]
  isDeleted      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([deadline])
}

model TaskSubmission {
  id                   Int       @id @default(autoincrement())
  taskId               Int
  task                 Task      @relation(fields: [taskId], references: [id])
  userId               Int
  user                 User      @relation(fields: [userId], references: [id], name: "UserSubmissions")
  reportText           String
  proofUrl             String?
  proofFileName        String?
  proofType            String?
  notes                String?
  completionPercentage Int       @default(100)
  blockers             String?
  reviewStatus         String    @default("Pending Review") // Pending Review, Approved, Rejected
  managerFeedback      String?
  reviewedById         Int?
  reviewedBy           User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  submittedAt          DateTime  @default(now())
  reviewedAt           DateTime?
  isDeleted            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([reviewStatus])
}

model DailyReport {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation("ReportOwner", fields: [userId], references: [id])
  departmentId    Int
  department      Department @relation(fields: [departmentId], references: [id])
  reportDate      DateTime @default(now())
  workCompleted   String
  pendingWork     String
  blockers        String?
  tomorrowPlan    String
  attachments     String
  taskIds         String?  // JSON array of Task IDs
  status          String   @default("Submitted") // Submitted, Reviewed, Needs Correction
  managerFeedback String?
  reviewedById    Int?
  reviewedBy      User?    @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reportDate])
  @@index([departmentId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type       String   // e.g. task_assigned, employee_created
  entityType String?  // e.g. User, Task, DailyReport
  entityId   Int?     // the ID of the entity
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action      String
  entityType  String?
  entityId    Int?
  description String?
  metadata    String?  // Store JSON as string
  ipAddress   String?
  userAgent   String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}
