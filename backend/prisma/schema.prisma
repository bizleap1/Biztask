generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     Int                 @id @default(autoincrement())
  name                   String
  email                  String              @unique
  password               String
  role                   String              @default("Employee") // SuperAdmin, Manager, TeamLead, Employee, ClientUser (legacy: DevEmployee, MediaEmployee, Viewer)
  designation            String?
  phone                  String?
  whatsappNumber         String?
  avatarUrl              String?
  googleId               String?             @unique
  tokenVersion           Int                 @default(0)
  isActive               Boolean             @default(true)
  mustChangePassword     Boolean             @default(true)
  resetPasswordRequested Boolean             @default(false)
  canResetPassword       Boolean             @default(false)
  resetTokenHash         String?
  resetTokenExpiresAt    DateTime?
  departmentId           Int?
  department             Department?         @relation(fields: [departmentId], references: [id])
  assignedTasks          Task[]              @relation("AssignedTo")
  createdTasks           Task[]              @relation("AssignedBy")
  submissions            TaskSubmission[]    @relation("UserSubmissions")
  reviewedSubmissions    TaskSubmission[]    @relation("ReviewedBy")
  dailyReports           DailyReport[]       @relation("ReportOwner")
  reviewedDailyReports   DailyReport[]       @relation("ReportReviewedBy")
  activityLogs           ActivityLog[]
  comments               Comment[]
  notifications          Notification[]
  ledTeams               Team[]              @relation("TeamLead")
  teamMemberships        TeamMembership[]
  managedClients         Client[]            @relation("AccountManager")
  clientMemberships      ClientMembership[]
  organizedMeetings      Meeting[]           @relation("MeetingOrganizer")
  meetingAttendances     MeetingAttendee[]
  meetingMinutes         MeetingMinute[]
  meetingActionItems     MeetingActionItem[] @relation("ActionItemAssignee")
  ownedLeads             Lead[]              @relation("LeadOwner")
  leadActivities         LeadActivity[]
  deals                  Deal[]              @relation("DealOwner")
  attendanceRecords      Attendance[]
  leaveRequests          LeaveRequest[]
  leaveApprovals         LeaveRequest[]      @relation("LeaveApprover")
  portalRequests         ClientRequest[]
  contentCalendars       ContentCalendar[]   @relation("CalendarCreator")
  contentItems           ContentItem[]       @relation("ContentItemCreator")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([role])
  @@index([departmentId])
}

model Department {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  users        User[]
  teams        Team[]
  projects     Project[]
  tasks        Task[]
  dailyReports DailyReport[]
  createdAt    DateTime      @default(now())
}

model Team {
  id           Int              @id @default(autoincrement())
  name         String
  departmentId Int?
  department   Department?      @relation(fields: [departmentId], references: [id])
  leadId       Int?
  lead         User?            @relation("TeamLead", fields: [leadId], references: [id])
  members      TeamMembership[]
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([name])
  @@index([departmentId])
  @@index([leadId])
}

model TeamMembership {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("Member") // Lead, Member
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Client {
  id               Int                @id @default(autoincrement())
  name             String
  companyName      String?
  email            String?
  phone            String?
  industry         String?
  status           String             @default("Active") // Active, At-Risk, Paused, Churned
  accountManagerId Int?
  accountManager   User?              @relation("AccountManager", fields: [accountManagerId], references: [id])
  memberships      ClientMembership[]
  contacts         ClientContact[]
  projects         Project[]
  tasks            Task[]
  meetings         Meeting[]
  deals            Deal[]
  invoices         Invoice[]
  contentCalendars ContentCalendar[]
  portalRequests   ClientRequest[]
  portalReports    PortalReport[]
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([accountManagerId])
  @@index([status])
}

model ClientContact {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  designation String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model Project {
  id           Int         @id @default(autoincrement())
  name         String
  description  String?
  clientId     Int
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  status       String      @default("Active") // Active, On Hold, Completed, Cancelled
  startDate    DateTime?
  endDate      DateTime?
  tasks        Task[]
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([clientId])
  @@index([departmentId])
  @@index([status])
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  category    String   @default("General") // General, Notifications, Security, ClientRules
  description String?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model ClientMembership {
  id        Int       @id @default(autoincrement())
  clientId  Int
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String    @default("Member") // Owner, Member
  isRevoked Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([clientId, userId])
  @@index([userId])
  @@index([isRevoked])
}

model Task {
  id                   Int                 @id @default(autoincrement())
  title                String
  description          String
  category             String
  priority             String              @default("Medium") // Low, Medium, High, Urgent
  status               String              @default("Pending") // Pending, In Progress, Submitted, Approved, Rejected, Overdue
  deadline             DateTime
  proofRequired        Boolean             @default(true)
  proofType            String? // Image, PDF, Video, Link, Screenshot, GitHub PR, Website URL, Social Media Link
  clientId             Int?
  client               Client?             @relation(fields: [clientId], references: [id])
  projectId            Int?
  project              Project?            @relation(fields: [projectId], references: [id])
  clientName           String? // General Project Field (legacy/display fallback)
  clientDetails        String? // General Project Field
  driveLink            String? // General Project Field
  socialMediaPlatform  String? // Media Dept Field
  postType             String? // Media Dept Field
  githubRepo           String? // Dev Dept Field
  environment          String? // Dev Dept Field
  departmentId         Int
  department           Department          @relation(fields: [departmentId], references: [id])
  assignedToId         Int?
  assignedTo           User?               @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById         Int
  assignedBy           User                @relation("AssignedBy", fields: [assignedById], references: [id])
  submissions          TaskSubmission[]
  comments             Comment[]
  meetingId            Int?
  meeting              Meeting?            @relation(fields: [meetingId], references: [id])
  actionItems          MeetingActionItem[]
  contentItem          ContentItem?
  clientVisible        Boolean             @default(false)
  clientApprovalStatus String              @default("NotRequested")
  isDeleted            Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([clientId])
  @@index([projectId])
  @@index([deadline])
  @@index([meetingId])
}

model Meeting {
  id              Int                 @id @default(autoincrement())
  title           String
  description     String?
  agenda          String?
  startAt         DateTime
  durationMinutes Int                 @default(30)
  locationLink    String?
  status          String              @default("Scheduled") // Scheduled, Completed, Cancelled
  repeatWeekly    Boolean             @default(false)
  organizerId     Int
  organizer       User                @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  clientId        Int?
  client          Client?             @relation(fields: [clientId], references: [id])
  attendees       MeetingAttendee[]
  minutes         MeetingMinute[]
  actionItems     MeetingActionItem[]
  tasks           Task[]
  externalEventId String?
  isDeleted       Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([startAt])
  @@index([organizerId])
  @@index([clientId])
  @@index([status])
}

model MeetingAttendee {
  id        Int      @id @default(autoincrement())
  meetingId Int
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  response  String   @default("Pending") // Pending, Accepted, Declined
  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
}

model MeetingMinute {
  id           Int      @id @default(autoincrement())
  meetingId    Int
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content      String
  recordedById Int
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([meetingId])
}

model MeetingActionItem {
  id          Int       @id @default(autoincrement())
  meetingId   Int
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assigneeId  Int?
  assignee    User?     @relation("ActionItemAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  status      String    @default("Open") // Open, Converted, Completed
  taskId      Int?
  task        Task?     @relation(fields: [taskId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([taskId])
  @@index([meetingId])
  @@index([assigneeId])
}

model Campaign {
  id        Int      @id @default(autoincrement())
  name      String
  source    String?
  status    String   @default("Active")
  leads     Lead[]
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Lead {
  id                Int            @id @default(autoincrement())
  name              String
  companyName       String?
  email             String?
  phone             String?
  source            String?
  stage             String         @default("New") // New, Contacted, Proposal, Negotiation, Won, Lost
  dealValue         Decimal        @default(0)
  expectedRevenue   Decimal        @default(0)
  ownerId           Int
  owner             User           @relation("LeadOwner", fields: [ownerId], references: [id])
  campaignId        Int?
  campaign          Campaign?      @relation(fields: [campaignId], references: [id])
  nextFollowUpAt    DateTime?
  lostReason        String?
  convertedClientId Int?
  deal              Deal?
  activities        LeadActivity[]
  isDeleted         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([stage])
  @@index([ownerId])
  @@index([campaignId])
  @@index([nextFollowUpAt])
}

model LeadActivity {
  id         Int       @id @default(autoincrement())
  leadId     Int
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  type       String    @default("Note") // Call, Email, Meeting, Proposal, Note
  subject    String
  notes      String?
  outcome    String?
  followUpAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([leadId])
  @@index([followUpAt])
}

model Deal {
  id              Int       @id @default(autoincrement())
  leadId          Int       @unique
  lead            Lead      @relation(fields: [leadId], references: [id])
  clientId        Int?
  client          Client?   @relation(fields: [clientId], references: [id])
  ownerId         Int
  owner           User      @relation("DealOwner", fields: [ownerId], references: [id])
  campaignId      Int?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  dealValue       Decimal   @default(0)
  revenue         Decimal   @default(0)
  collectedAmount Decimal   @default(0)
  status          String    @default("Won")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([ownerId])
  @@index([clientId])
  @@index([campaignId])
}

model TaskSubmission {
  id                   Int       @id @default(autoincrement())
  taskId               Int
  task                 Task      @relation(fields: [taskId], references: [id])
  userId               Int
  user                 User      @relation(fields: [userId], references: [id], name: "UserSubmissions")
  reportText           String
  proofUrl             String?
  proofFileName        String?
  proofType            String?
  notes                String?
  completionPercentage Int       @default(100)
  blockers             String?
  reviewStatus         String    @default("Pending Review") // Pending Review, Approved, Rejected
  managerFeedback      String?
  reviewedById         Int?
  reviewedBy           User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  submittedAt          DateTime  @default(now())
  reviewedAt           DateTime?
  isDeleted            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([reviewStatus])
}

model DailyReport {
  id              Int        @id @default(autoincrement())
  userId          Int
  user            User       @relation("ReportOwner", fields: [userId], references: [id])
  departmentId    Int
  department      Department @relation(fields: [departmentId], references: [id])
  reportDate      DateTime   @default(now())
  workCompleted   String
  pendingWork     String
  blockers        String?
  tomorrowPlan    String
  attachments     String
  taskIds         String? // JSON array of Task IDs
  status          String     @default("Submitted") // Submitted, Reviewed, Needs Correction
  managerFeedback String?
  reviewedById    Int?
  reviewedBy      User?      @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  isDeleted       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([reportDate])
  @@index([departmentId])
}

model ScheduledJob {
  id         Int                   @id @default(autoincrement())
  name       String                @unique
  schedule   String?
  enabled    Boolean               @default(true)
  lastRunAt  DateTime?
  lastStatus String?
  attempts   ScheduledJobAttempt[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([enabled])
}

model ScheduledJobAttempt {
  id             Int           @id @default(autoincrement())
  jobId          Int?
  job            ScheduledJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobName        String
  status         String        @default("Running") // Running, Succeeded, Failed
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  processed      Int           @default(0)
  skipped        Int           @default(0)
  errors         Int           @default(0)
  errorMessage   String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())

  @@index([jobName])
  @@index([status])
  @@index([startedAt])
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  title      String
  message    String
  isRead     Boolean  @default(false)
  type       String // e.g. task_assigned, employee_created
  entityType String? // e.g. User, Task, DailyReport
  entityId   Int? // the ID of the entity
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entityType  String?
  entityId    Int?
  description String?
  metadata    String? // Store JSON as string
  ipAddress   String?
  userAgent   String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model ClientRequest {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedById Int
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  title         String
  description   String
  status        String   @default("Pending") // Pending, Accepted, Declined, Converted
  taskId        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([requestedById])
}

model PortalReport {
  id             Int       @id @default(autoincrement())
  clientId       Int
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  reportingMonth Int
  reportingYear  Int
  status         String    @default("Draft") // Draft, Published
  content        Json?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clientId, reportingMonth, reportingYear])
  @@index([clientId])
  @@index([status])
}

model IntegrationAccount {
  id                   Int       @id @default(autoincrement())
  provider             String
  accountName          String?
  externalAccountId    String?
  status               String    @default("Disconnected") // Disconnected, Connected, Error
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  isEnabled            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([provider, externalAccountId])
  @@index([provider])
  @@index([status])
}

model SyncLog {
  id          Int       @id @default(autoincrement())
  provider    String
  status      String // Started, Succeeded, Failed
  externalRef String?
  message     String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([provider])
  @@index([status])
  @@index([startedAt])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  clientId      Int
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  status        String        @default("Draft") // Draft, Issued, PartiallyPaid, Paid, Overdue, Cancelled
  subtotal      Decimal       @default(0)
  cgstAmount    Decimal       @default(0)
  sgstAmount    Decimal       @default(0)
  igstAmount    Decimal       @default(0)
  totalAmount   Decimal       @default(0)
  amountPaid    Decimal       @default(0)
  snapshot      Json?
  issuedAt      DateTime?
  items         InvoiceItem[]
  receipts      Receipt[]
  createdById   Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1)
  unitPrice   Decimal @default(0)
  taxRate     Decimal @default(0)
  lineTotal   Decimal @default(0)

  @@index([invoiceId])
}

model Receipt {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount        Decimal
  receiptNumber String   @unique
  receivedAt    DateTime @default(now())
  method        String   @default("Bank")
  reference     String?
  notes         String?
  createdById   Int?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([receivedAt])
}

model Attendance {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDate    DateTime
  checkInAt   DateTime?
  checkOutAt  DateTime?
  status      String    @default("Present") // Present, Late, Half-Day, Absent
  source      String    @default("Manual") // Manual, Petpooja, Google
  externalRef String?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workDate, externalRef], map: "Attendance_user_workDate_externalRef_key")
  @@index([userId])
  @@index([workDate])
  @@index([externalRef])
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  approverId Int?
  approver   User?    @relation("LeaveApprover", fields: [approverId], references: [id])
  leaveType  String   @default("Casual")
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String   @default("Pending") // Pending, Approved, Rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate])
}

model Holiday {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([date])
  @@index([isActive])
}

model ContentCalendar {
  id          Int           @id @default(autoincrement())
  title       String
  month       Int // 1-12
  year        Int
  clientId    Int
  client      Client        @relation(fields: [clientId], references: [id])
  createdById Int
  createdBy   User          @relation("CalendarCreator", fields: [createdById], references: [id])
  status      String        @default("Draft") // Draft, Active, Completed, Archived
  notes       String?
  items       ContentItem[]
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([clientId, month, year])
  @@index([clientId])
  @@index([createdById])
  @@index([status])
}

model ContentItem {
  id            Int             @id @default(autoincrement())
  calendarId    Int
  calendar      ContentCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  platform      String // Instagram, Facebook, LinkedIn, Twitter, YouTube, Website, Other
  postType      String // Reel, Carousel, Static Post, Story, Blog, Video
  topic         String
  content       String
  objective     String?
  visualIdea    String?
  hashtags      String?
  status        String          @default("Draft") // Draft, Approved, Rejected, ConvertedToTask
  reviewNotes   String?
  taskId        Int?            @unique
  task          Task?           @relation(fields: [taskId], references: [id])
  createdById   Int
  createdBy     User            @relation("ContentItemCreator", fields: [createdById], references: [id])
  aiGenerated   Boolean         @default(false)
  isDeleted     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([calendarId])
  @@index([scheduledDate])
  @@index([status])
  @@index([platform])
}
